          "sequenceNumber": 3,
          "speaker": "步骤 2",
          "english": "从积的右边起数出 3 位，得到 0.180。",
          "chinese": "位数不够时，在积的左边补 0。"
        },
        {
          "sequenceNumber": 4,
          "speaker": "答案",
          "english": "0.36 × 0.5 = 0.18。",
          "chinese": "小数末尾的 0 可以去掉。"

      "title": "例题 2：一个数除以小数",
      "lines": [
        {
          "sequenceNumber": 1,
          "speaker": "题目",
          "english": "计算：4.68 ÷ 0.12。",
          "chinese": "除数 0.12 有两位小数。"
        },
        {
          "sequenceNumber": 2,
          "speaker": "步骤 1",
          "english": "把除数的小数点向右移动两位：0.12 → 12。",
          "chinese": "目标是把除数转化为整数。"
        },
        {
          "sequenceNumber": 3,
          "speaker": "步骤 2",
          "english": "被除数的小数点也向右移动两位：4.68 → 468。",
          "chinese": "被除数和除数同时扩大 100 倍，商不变。"
        },
        {
          "sequenceNumber": 4,
          "speaker": "答案",
          "english": "4.68 ÷ 0.12 = 468 ÷ 12 = 39。",
          "chinese": "转化后按整数除法计算。"
        }
      ]

          "sequenceNumber": 2,
          "speaker": "单位",
          "english": "0.4 是 4 个十分之一；0.07 是 7 个百分之一。",
          "chinese": "十分之一乘百分之一是千分之一。"
        },
        {
          "sequenceNumber": 3,
          "speaker": "计算",
          "english": "4 × 7 = 28；28 个千分之一是 0.028。",
          "chinese": "积的单位由两个因数的单位相乘而来。"
        },
        {
          "sequenceNumber": 4,
          "speaker": "检查",
          "english": "0.07 小于 1，0.4 × 0.07 应小于 0.4。",
          "chinese": "用乘数大小判断结果。"

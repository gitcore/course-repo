      "title": "例题 5：同单位的除法",
      "lines": [
        {
          "sequenceNumber": 1,
          "speaker": "题目",
          "english": "计算 0.72 ÷ 0.09。",
          "chinese": "把两个数都看作百分之一的个数。"

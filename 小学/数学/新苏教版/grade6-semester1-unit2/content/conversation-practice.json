          "sequenceNumber": 3,
          "speaker": "求今年",
          "english": "80 + 30 = 110（棵），也可列 80 × (1 + 3/8)。",
          "chinese": "原数加增加量。"
        },
        {
          "sequenceNumber": 4,
          "speaker": "检查",
          "english": "110 棵比 80 棵多 30 棵；30 ÷ 80 = 3/8。",
          "chinese": "用分率反查。"
